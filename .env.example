# ===== 站点基本信息 =====
NEXT_PUBLIC_SITE_URL=https://baolimei.cn
NEXT_PUBLIC_ICP_BEIAN=备案中
NEXT_PUBLIC_PSB_BEIAN=
NEXT_PUBLIC_COMPANY=流花

# ===== 运行环境 =====
# development / staging / production
APP_ENV=development
NODE_ENV=development
# 生产环境必须使用独立数据库，禁止复用开发库
DATABASE_URL=postgresql://blm_dev:CHANGE_ME@127.0.0.1:5432/baolimei_dev
REDIS_URL=redis://127.0.0.1:6379/0
DATABASE_POOL_MAX=8

# ===== 安全密钥（至少 32 字符，生产环境必须重新生成） =====
AUTH_SECRET=CHANGE_ME_32_CHARS_MINIMUM_SECRET
STORAGE_SECRET=CHANGE_ME_32_CHARS_MINIMUM_SECRET
COOKIE_SECURE=false
ALLOWED_ORIGINS=https://baolimei.cn,https://www.baolimei.cn

# ===== 文件存储 =====
# local = 服务器本地卷；s3 = S3 兼容对象存储
STORAGE_DRIVER=local
DATA_DIR=/opt/baolimei/data
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ===== 短信 =====
# console：仅开发环境；aliyun：阿里云短信；http：自定义短信网关
SMS_PROVIDER=console
ALLOW_DEV_SMS=1
ALLOW_DEV_SMS_RESPONSE=1
# 阿里云短信（签名使用已审核通过的「流花科技」/「广州流花科技」）
# 以下两种命名都支持：ALIYUN_SMS_ACCESS_KEY_ID 或 ALIYUN_ACCESS_KEY_ID
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=广州流花科技
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_TEMPLATE_PARAM_NAME=code
ALIYUN_SMS_REGION=cn-hangzhou
ALIYUN_SMS_ENDPOINT=https://dysmsapi.aliyuncs.com/
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_TEMPLATE_ID=login

# ===== AI 任务 =====
WORKER_ENABLED=1
# 仅开发环境允许 Mock；生产必须为 0
MOCK_GENERATION_ENABLED=1
FAL_KEY=
REPLICATE_API_TOKEN=
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
