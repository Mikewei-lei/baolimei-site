# ===== 站点基本信息 =====
# 正式域名（用于 canonical / sitemap / og:url）
NEXT_PUBLIC_SITE_URL=https://baolimei.cn
# ICP 备案号（管局通过后填写完整号，例如：京ICP备2026000000号-1）
NEXT_PUBLIC_ICP_BEIAN=备案中
# 公安网备（可选）
NEXT_PUBLIC_PSB_BEIAN=
# 运营主体名称
NEXT_PUBLIC_COMPANY=葆历莓（北京）科技有限公司

# ===== 生成能力（可选，不配置则运行在演示模式） =====
# 演示模式：返回占位画面，不产生费用
GENERATION_MOCK=1
# fal.ai（可调用 Kling / Veo / Wan / Flux 等模型）
FAL_KEY=
# Replicate
REPLICATE_API_TOKEN=
# 火山方舟（豆包·即梦 Seedream / Seedance）
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
